# Скопируйте в .env рядом с docker-compose.yml. Настоящие секреты не коммитьте.
# Этот общий файл передаётся приложению, PostgreSQL и Caddy.

# Приложение
APP_NAME="Спортивный клуб ТюмГУ"
APP_VERSION=0.1.0
PRODUCTION=true
APP_DEBUG=false
DATABASE_ECHO=false
SESSION_COOKIE_SECURE=true

# Домен и HTTPS: домен без схемы, порта и пути.
DOMAIN=club.example.org
ACME_EMAIL=admin@example.ru
PUBLIC_BASE_URL=https://${DOMAIN}

# База данных внутри Docker: хост postgres, НЕ localhost.
POSTGRES_USER=sportclub
POSTGRES_DB=sportclub
# Сгенерируйте отдельное значение: python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Независимый случайный секрет, не повторяйте пароль БД.
SECRET_KEY=

# Yandex SmartCaptcha: ysc1_... — клиентский, ysc2_... — серверный.
CAPTCHA_ENABLED=true
SMARTCAPTCHA_CLIENT_KEY=
SMARTCAPTCHA_SERVER_KEY=
SMARTCAPTCHA_ALLOWED_HOSTS=${DOMAIN}

# CSP: основной режим принудительный; режим виджета переключите после проверки.
CSP_REPORT_ONLY=false
CSP_CAPTCHA_REPORT_ONLY=true

# Лимиты запросов и входа
REQUEST_LIMIT_PER_MINUTE=120
REGISTRATION_LIMIT_PER_MINUTE=10
ADMIN_LOGIN_ACCOUNT_LIMIT=5
ADMIN_LOGIN_IP_LIMIT=30
ADMIN_LOGIN_WINDOW_SECONDS=900

# Участники и время
UNIVERSITY_EMAIL_DOMAIN=study.utmn.ru
APP_TIMEZONE=Asia/Yekaterinburg
