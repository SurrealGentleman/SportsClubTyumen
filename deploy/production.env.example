# Copy values to Render Environment, NOT to a committed secret file.
# Enable PRODUCTION only after creating the CAPTCHA and setting every value.
PRODUCTION=true
APP_DEBUG=false
DATABASE_ECHO=false
SESSION_COOKIE_SECURE=true
CSP_REPORT_ONLY=false
CSP_CAPTCHA_REPORT_ONLY=true
# On Render this can be omitted: RENDER_EXTERNAL_URL is detected automatically.
PUBLIC_BASE_URL=https://YOUR-SERVICE.onrender.com
CAPTCHA_ENABLED=true
SMARTCAPTCHA_CLIENT_KEY=PASTE_CLIENT_KEY_FROM_YANDEX
SMARTCAPTCHA_SERVER_KEY=PASTE_SERVER_KEY_FROM_YANDEX
SMARTCAPTCHA_ALLOWED_HOSTS=YOUR-SERVICE.onrender.com
REQUEST_LIMIT_PER_MINUTE=120
REGISTRATION_LIMIT_PER_MINUTE=10
ADMIN_LOGIN_ACCOUNT_LIMIT=5
ADMIN_LOGIN_IP_LIMIT=30
ADMIN_LOGIN_WINDOW_SECONDS=900
UNIVERSITY_EMAIL_DOMAIN=study.utmn.ru
APP_TIMEZONE=Asia/Yekaterinburg
# Keep the existing DATABASE_URL and a unique random SECRET_KEY in Render.
# FORWARDED_ALLOW_IPS is configured by Render's Python runtime automatically.
